      "blocks": [
        {
          "type": "clauses",
          "items": [
            {
              "text": "Игроки договариваются о времени матча в Discord."
            },
            {
              "text": "Один из игроков заходит на сайт драфта и создаёт лобби."
            },
            {
              "text": "Второй игрок присоединяется по ссылке."
            },
            {
              "text": "Система определяет, кто банит первым — рандомно или по фиксированной сетке."
            },
            {
              "text": "Происходит пик боссов → пик персонажей → матч."
            },
            {
              "text": "По завершении матча игроки присылают организатору скриншот результата."
            }
