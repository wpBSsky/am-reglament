      "blocks": [
        {
          "type": "clauses",
          "items": [
            {
              "text": "Цель ограничений — не душить косты, а сделать турнир доступным."
            },
            {
              "text": "Косты сделаны так, чтобы никто не играл на дд норме, дабл стан мияби и т.д.",
              "n": ""
