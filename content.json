      "id": "shtrafy",
      "title": "Штрафы и нарушения",
      "blocks": [
        {
          "type": "note",
          "tone": "ban",
          "label": "Безусловная дисквалификация",
          "text": "Использование багов, мошенничество, подмена аккаунта, договорной матч — немедленная дисквалификация без права обжалования."
        },
        {
          "type": "clauses",
          "items": [
            {
              "text": "Опоздание на матч более 15 минут — техническое поражение."
            },
            {
              "text": "Отказ от переигровки при ничье — техническое поражение."
            },
            {
              "text": "Отсутствие скриншота — результат не засчитывается."
            },
            {
              "text": "Оскорбление оппонента — предупреждение, повторное — дисквалификация."
            }
          ]
        }
